<!-- ===== HEADER SAMA PERSIS DENGAN DAFTAR ORDER ===== -->
<div class="order-header">
  <div class="header-left">
    <%= image_tag "washstep.png", alt: "WashStep Logo", width: "120" %> 
  </div>

  <div class="header-center">
    <h1>Detail Order</h1>
  </div>
</div>

<style>
  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    background-color: #7b4b26; /* sama seperti daftar */
    font-family: "Poppins", Arial, sans-serif;
  }

  /* ===== HEADER FIXED ===== */
  .order-header {
    background-color: #7b4b26;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px 60px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 1000;
    box-shadow: 0 4px 10px rgba(0,0,0,0.25);
  }

  .header-left {
    position: absolute;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
  }

  .washstep-logo {
    height: 55px;
  }

  .header-center h1 {
    margin: 0;
    font-size: 28px;
    letter-spacing: 1px;
    font-weight: 600;
    text-align: center;
  }

  /* ===== CONTENT BOX ===== */
  .show-container {
    max-width: 900px;
    margin: 180px auto 60px; /* DI TURUNKAN KARENA HEADER FIXED */
    background: #c96f24;
    padding: 40px 65px;
    border-radius: 22px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    color: #000;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 19px;
  }

  .detail-label {
    font-weight: 600;
  }

  .detail-value {
    font-weight: 400;
    text-align: right;
  }

  .button-group {
    margin-top: 40px;
    display: flex;
    gap: 18px;
    justify-content: center;
  }

  .btn {
    padding: 12px 26px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 17px;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  .edit-btn {
    background: #ffd28a;
    color: #000;
  }

  .delete-btn {
    background: #ff9b72;
    color: #000;
  }

  .back-btn {
    background: #ffe0b5;
    color: #000;
  }
</style>


<!-- ===== ISI DETAIL ORDER (TETAP SAMA) ===== -->
<div class="show-container">

  <div class="detail-row">
    <span class="detail-label">Customer</span>
    <span class="detail-value"><%= @order.customer&.name %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">No HP</span>
    <span class="detail-value"><%= @order.customer&.phone %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Email</span>
    <span class="detail-value"><%= @order.customer&.email %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Alamat Rumah</span>
    <span class="detail-value"><%= @order.customer&.address %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Sepatu</span>
    <span class="detail-value"><%= @order.shoe_name %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Service</span>
    <span class="detail-value"><%= @order.service.name %> – Rp <%= @order.service.price %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Status</span>
    <span class="detail-value"><%= @order.status %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Total Harga</span>
    <span class="detail-value">Rp <%= @order.total_price %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Tanggal Order</span>
    <span class="detail-value"><%= @order.created_at.strftime("%d %B %Y, %H:%M") %></span>
  </div>

  <div class="button-group">
    <%= link_to "Edit", edit_order_path(@order), class: "btn edit-btn" %>
    <%= link_to "Hapus", order_path(@order),
          data: { turbo_method: :delete, turbo_confirm: "Hapus order ini?" },
          class: "btn delete-btn" %>
    <%= link_to "Kembali", orders_path, class: "btn back-btn" %>
  </div>

</div>
