<h1>Detail Order</h1>

<style>
  body {
    background: #e89348;
    font-family: 'Poppins', sans-serif;
    margin: 0;
    padding: 0;
  }

  h1 {
    text-align: center;
    background-color: #7b441b;
    color: white;
    font-size: 40px;
    font-weight: bold;
    margin: 0;
    padding: 20px 0;
  }

  .show-container {
    max-width: 900px;
    margin: 80px auto;
    background: #c96f24;
    padding: 40px 60px;
    border-radius: 20px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    color: #000;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
    font-size: 18px;
  }

  .detail-label {
    font-weight: 600;
  }

  .detail-value {
    font-weight: 400;
  }

  .button-group {
    margin-top: 35px;
    display: flex;
    gap: 15px;
    justify-content: center;
  }

  .btn {
    padding: 10px 24px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
  }

  .edit-btn {
    background: #ffd28a;
    color: #000;
  }

  .delete-btn {
    background: #ff9b72;
    color: #000;
  }

  .back-btn {
    background: #ffe0b5;
    color: #000;
  }
</style>
<div class="header-left">
      <%= image_tag "washstep.png", alt: "WashStep Logo", width: "120" %>
    </div>``

<div class="show-container">

  <div class="detail-row">
    <span class="detail-label">Customer</span>
    <span class="detail-value"><%= @order.customer&.name %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">No HP</span>
    <span class="detail-value"><%= @order.customer&.phone %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Email</span>
    <span class="detail-value"><%= @order.customer&.email %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Alamat Rumah</span>
    <span class="detail-value"><%= @order.customer&.address %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Sepatu</span>
    <span class="detail-value"><%= @order.shoe_name %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Service</span>
    <span class="detail-value"><%= @order.service.name %> – Rp <%= @order.service.price %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Status</span>
    <span class="detail-value"><%= @order.status %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Total Harga</span>
    <span class="detail-value">Rp <%= @order.total_price %></span>
  </div>

  <div class="detail-row">
    <span class="detail-label">Tanggal Order</span>
    <span class="detail-value"><%= @order.created_at.strftime("%d %B %Y, %H:%M") %></span>
  </div>

  <div class="button-group">
    <%= link_to "Edit", edit_order_path(@order), class: "btn edit-btn" %>
    <%= link_to "Hapus", order_path(@order), data: { turbo_method: :delete, turbo_confirm: "Hapus order ini?" }, class: "btn delete-btn" %>
    <%= link_to "Kembali", orders_path, class: "btn back-btn" %>
  </div>

</div>
