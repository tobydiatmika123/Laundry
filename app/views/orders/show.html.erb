<div class="header-bar">
  <div class="header-left">
    <%= image_tag "washstep.png", alt: "WashStep", class: "logo-header" %>
  </div>
  <h1 class="header-title">Detail Order</h1>
</div>

<div class="order-detail-wrapper">

  <div class="detail-card">

    <div class="detail-row">
      <label>Customer</label>
      <div class="value"><%= @order.customer&.name || "-" %></div>
    </div>

    <div class="detail-row">
      <label>Telepon</label>
      <div class="value"><%= @order.customer&.phone || "-" %></div>
    </div>

    <div class="detail-row">
      <label>Email</label>
      <div class="value"><%= @order.customer&.email || "-" %></div>
    </div>

    <div class="detail-row">
      <label>Alamat</label>
      <div class="value"><%= @order.customer&.address || "-" %></div>
    </div>

    <div class="detail-row">
      <label>Shoe</label>
      <div class="value"><%= @order.shoe_name || "-" %></div>
    </div>

    <div class="detail-row">
      <label>Service</label>
      <div class="value">
        <% if @order.service %>
          <%= "#{@order.service.name} - Rp #{number_with_delimiter(@order.service.price, delimiter: '.')}" %>
        <% else %>
          -
        <% end %>
      </div>
    </div>

    <div class="detail-row">
      <label>Status</label>
      <div class="value"><%= @order.status || "Proses" %></div>
    </div>

    <div class="detail-row">
      <label>Total Harga</label>
      <div class="value">Rp <%= number_with_delimiter(@order.total_price || 0, delimiter: '.') %></div>
    </div>

    <div class="detail-row">
      <label>Tanggal Order</label>
      <div class="value"><%= @order.order_date&.strftime("%d %B %Y, %H:%M") || "-" %></div>
    </div>

    <!-- Tombol -->
    <div class="btn-group">
      <%= link_to "Edit", edit_order_path(@order), class: "btn-edit" %>
      <%= button_to "Hapus", @order, method: :delete, data: { turbo_confirm: "Yakin hapus order ini?" }, class: "btn-delete" %>
      <%= link_to "Kembali", orders_path, class: "btn-back" %>
    </div>

  </div>
</div>

<style>
  /* HEADER FIXED */
  .header-bar {
    background: #7a3f0c;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed; /* tetap di atas */
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
  }

  .header-left {
    position: absolute;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
  }

  .logo-header {
    width: 150px;
    height: auto;
  }

  .header-title {
    color: white;
    font-size: 40px;
    font-weight: 800;
    margin: 0;
    text-align: center;
  }

  /* DETAIL PAGE */
  .order-detail-wrapper {
    text-align: center;
    padding: 40px 0;
    margin-top: 150px; /* biar ga ketiban header */
  }

  .detail-card {
    background: #c66b20;
    width: 70%;
    margin: auto;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    text-align: left;
    color: white; /* semua teks putih */
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #b55e1b;
    font-size: 18px;
  }

  .detail-row label {
    font-weight: bold;
    color: #fff; /* label putih */
  }

  .value {
    color: #fff; /* nilai putih */
  }

  /* BUTTONS */
  .btn-group {
    margin-top: 25px;
    display: flex;
    gap: 15px;
  }

  .btn-edit,
  .btn-delete,
  .btn-back {
    padding: 10px 20px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: bold;
    color: white;
    border: none;
    cursor: pointer;
  }

  .btn-edit { background: #5c2d0a; }
  .btn-delete { background: #b32020; }
  .btn-back { background: #6f3f1c; }
</style>
